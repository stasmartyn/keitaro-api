# Server Configuration
PORT=5005
NODE_ENV=development
# Authentication
AUTH_TOKEN=your_auth_token_here
EXPORT_TOKEN=your-export-token-here
# Keitaro API Configuration
KEITARO_DOMAIN_DEV=https://dev.keitaro.domain
KEITARO_DOMAIN=https://keitaro.domain
KEITARO_API_KEY=your_api_key_here
KEITARO_API_KEY_DEV=your_dev_api_key_here

# Keitaro Groups
KEITARO_ORG_GROUP_ID=1
KEITARO_CLO_GROUP_ID=2

# Campaign Templates
IOS_CLO_CAMPAIGN_TEMPLATE_ID=100
NEW_FLOW_CLO_CAMPAIGN_TEMPLATE_ID=101
IOS_ORG_CAMPAIGN_TEMPLATE_ID=102
ANDROID_CLO_CAMPAIGN_TEMPLATE_ID=103
ANDROID_ORG_CAMPAIGN_TEMPLATE_ID=104

# W2App Groups
W2APP_CAMPAIGN_GROUP_ID=61
W2APP_NAMING_GROUP_ID=61

# Empty campaign (create-empty-campaign): template ID by NODE_ENV
EMPTY_CAMPAIGN_TEMPLATE_ID_DEV=105
EMPTY_CAMPAIGN_TEMPLATE_ID_PROD=106

# Sub IDs
IOS_SUB_ID=ios_sub
ANDROID_SUB_ID=android_sub

# Failover Configuration
APPLINK_CAMPAIGN_GROUP_ID=8
APPLINK_BANNED_CAMPAIGN_GROUP_ID=9
DEFAULT_APPLINK_CAMPAIGN_ID=5
MIN_CAMPAIGN_ID=0

APPLINK_BANNED_DOMAIN_GROUP_ID=12

APPLINK_PRIVATE_OFFER_GROUP_ID=7
APPLINK_PUBLIC_OFFER_GROUP_ID=10
APPLINK_BANNED_OFFER_GROUP_ID=11

DEFAULT_STREAM_ID=35
STREAM_LANDING_ID=2

CAMPAIGNS_PAGE_SIZE=100

# Database
MONGO_DATABASE_URI_DEV=mongodb://localhost:27017/keitaro_dev
MONGO_DATABASE_URI=mongodb://localhost:27017/keitaro

# Campaign users (окрема БД для колекції campaignUser)
MONGO_CAMPAIGN_USERS_DATABASE_URI_DEV=
MONGO_CAMPAIGN_USERS_DATABASE_URI=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

