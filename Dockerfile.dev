### Stage: deps — install all dependencies (including dev) for build
FROM node:20-alpine AS deps

WORKDIR /app

COPY package*.json ./
# Speed up install, skip lifecycle scripts (e.g., husky); dev deps are needed to build TS
RUN npm ci --ignore-scripts --no-audit --no-fund

### Stage: build — compile TypeScript to dist
FROM deps AS build

COPY tsconfig.json ./

COPY src ./src

RUN npx tsc -p tsconfig.json \
    && mkdir -p dist/assets \
    && cp -r src/assets dist/assets || true

### Stage: runner — development image with all dependencies
FROM node:20-alpine AS runner
ENV NODE_ENV=development
WORKDIR /app

RUN apk update \
    && apk upgrade --no-cache \
    && apk add --no-cache bash wget \
    && wget -qO- 'https://artifacts-cli.infisical.com/setup.apk.sh' | sh \
    && apk update \
    && apk add --no-cache infisical

# Install ALL dependencies (including dev deps for nest CLI)
COPY --from=deps /app/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

# Copy compiled app
COPY --from=build /app/dist ./dist
COPY tsconfig.json ./
# Copy source files for watch mode
COPY src ./src

CMD ["npm", "run", "start:dev"]

